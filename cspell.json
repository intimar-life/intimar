{
  "version": "0.2",
  // British spelling is the house style for prose and comments; en (US) stays
  // enabled because library APIs and existing identifiers use it
  // (`specialties`, PrimeVue's `Dialog`).
  "language": "en-GB,en,es",
  "import": ["@cspell/dict-es-es/cspell-ext.json"],
  "dictionaries": ["es-es"],
  // Reuses .gitignore (dist/, node_modules/, .astro/, storybook-static, …)
  // as the primary exclusion list instead of duplicating it here — only
  // paths NOT already gitignored need an explicit entry below.
  "useGitignore": true,
  "ignorePaths": [
    ".git",
    "package-lock.json",
    "coverage",
    // Vendored third-party skill docs — not our prose to spellcheck.
    ".claude/skills"
  ],
