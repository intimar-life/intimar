---
import { Font, getImage } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { UMAMI_WEBSITE_ID, withBase } from '../lib/site';
import { getAllBlogPosts } from '../lib/data';
// Default share card for pages without their own image (events and blog
// posts pass theirs): the brand mark centred on --color-hero-bg at the
// 1200x630 Open Graph size. Composed from logo-full.png rather than using
// the logo directly, because the logo is tall and transparent — social
// previews would crop it and fill the transparency black or white.
import ogDefaultSource from '../data/images/site/og-logo.png';
// primeicons ships its @font-face with font-display: block, so on any
// connection slow enough to miss its ~3s block window (verified via a
// throttled CDP screencast — every pi-* glyph on the page, e.g. the header's
// dark/light toggle, the events search icon) renders as the browser's
// fallback notdef glyph until the font arrives. Preloading it (resolved to
// the real fingerprinted asset via Vite's `?url`, not a hardcoded path)
// lets the browser fetch it in parallel with other head resources instead
// of discovering it only after the CSS is parsed, keeping it inside the
// block window on realistic networks.
import primeiconsFontUrl from 'primeicons/fonts/primeicons.woff2?url';

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  // Blog posts pass 'article' plus the two fields below, so shares render
  // with Open Graph's article treatment (date/author) instead of a plain
  // link card — every other page stays the 'website' default.
  ogType?: 'website' | 'article';
  articlePublishedTime?: string;
  articleAuthor?: string;
}

const defaultOgImage = await getImage({
  src: ogDefaultSource,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpg',
});

const {
  title,
  description = 'Intimar — retiros de neotantra presenciales, guiados por nuestro propio equipo.',
  image = defaultOgImage.src,
  imageAlt = 'Logo de Intimar',
  imageWidth = 1200,
  imageHeight = 630,
  structuredData,
  noindex = false,
  ogType = 'website',
  articlePublishedTime,
  articleAuthor,
} = Astro.props;

// Analytics only on the real, public site: production builds, and not on
// pages hidden from search (noindex: /admin, the 404, disabled pages). The
// script's data-domains also keeps localhost/staging visits from counting.
const analytics = UMAMI_WEBSITE_ID !== '' && import.meta.env.PROD && !noindex;

// Don't advertise an empty feed to feed readers while no post is published.
const hasBlogPosts = (await getAllBlogPosts()).length > 0;

const structuredDataEntries = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];

const pageTitle = `${title} · Intimar`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// og:image/twitter:image must be absolute — `image` may be a root-relative
// build path (astro:assets output, or a page's own image.src override).
const absoluteImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const isDark = stored
          ? stored === 'dark'
          : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('app-dark', isDark);
      })();
    </script>
    <link
      rel="preload"
      href={primeiconsFontUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href={`${withBase('/favicon.ico')}?v=2`} sizes="any" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={`${withBase('/favicon-32x32.png')}?v=2`}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href={`${withBase('/favicon-16x16.png')}?v=2`}
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={withBase('/apple-touch-icon.png')}
    />
    {hasBlogPosts && (
      <link
        rel="alternate"
        type="application/rss+xml"
        title="Intimar — Blog"
        href={withBase('/rss.xml')}
      />
    )}
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Intimar" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={absoluteImageURL} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="es_CL" />
    {ogType === 'article' && articlePublishedTime && (
      <meta property="article:published_time" content={articlePublishedTime} />
    )}
    {ogType === 'article' && articleAuthor && (
      <meta property="article:author" content={articleAuthor} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {/* Families are configured in astro.config.mjs. Only the body face and
        upright headings are preloaded — a preload downloads its file on
        every page whether used or not, so Fraunces italic and the accent
        faces (testimonials, the hero's script word) load on demand, which
        keeps pages inside Lighthouse's font-size budget. */}
    <Font cssVariable="--ff-belleza" preload />
    <Font cssVariable="--ff-fraunces" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--ff-special-elite" />
    <Font cssVariable="--ff-allura" />

    {structuredDataEntries.map((data) => (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(data)}
      ></script>
    ))}
    {analytics && (
      <script
        is:inline
        defer
        src="https://cloud.umami.is/script.js"
        data-website-id={UMAMI_WEBSITE_ID}
        data-domains="intimar.life"
        data-do-not-track="true"
      />
    )}
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-md focus:bg-ink-900 focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-ink-50"
    >
      Saltar al contenido
    </a>
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
