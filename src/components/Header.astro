---
import { Image } from 'astro:assets';
import { CONTACT_PAGE_ENABLED, withBase } from '../lib/site';
import { getAllBlogPosts } from '../lib/data';
import logoFullLight from '../data/images/site/logo-full-light.png';
import logoFullDark from '../data/images/site/logo-full.png';

// An empty blog isn't worth a nav slot — the link returns on its own once
// any post is published again.
const hasBlogPosts = (await getAllBlogPosts()).length > 0;

const navLinks = [
  { href: withBase('/events'), label: 'Retiros' },
  { href: withBase('/team'), label: 'Facilitadores' },
  ...(hasBlogPosts ? [{ href: withBase('/blog'), label: 'Blog' }] : []),
  { href: withBase('/about'), label: 'Nosotros' },
  { href: withBase('/faq'), label: 'Preguntas frecuentes' },
  ...(CONTACT_PAGE_ENABLED
    ? [{ href: withBase('/contact'), label: 'Contacto' }]
    : []),
];
---

<header class="sticky top-0 z-40 border-b border-ink-200/60 bg-ink-50/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a
      href={withBase('/')}
      class="flex items-center gap-2 font-serif text-xl tracking-wide text-ink-900"
    >
      <Image
        src={logoFullLight}
        alt=""
        width={489}
        height={1150}
        class="h-18 w-auto in-[.app-dark]:hidden"
      />
      <Image
        src={logoFullDark}
        alt=""
        width={489}
        height={1150}
        class="hidden h-18 w-auto in-[.app-dark]:block"
      />
      Intimar
    </a>

    <nav
      aria-label="Navegación principal"
      class="hidden items-center gap-8 md:flex"
    >
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm text-ink-700 transition hover:text-ink-900"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-3 md:flex">
      <button
        id="theme-toggle"
        type="button"
        aria-label="Cambiar tema"
        aria-pressed="false"
        data-umami-event="cambio_tema"
        data-umami-event-tema="oscuro"
        class="rounded-md p-2 text-ink-700 transition hover:text-ink-900"
      >
        <span
          class="pi pi-moon text-lg"
          data-theme-icon="dark"
          aria-hidden="true"
        ></span>
        <span
          class="pi pi-sun hidden text-lg"
          data-theme-icon="light"
          aria-hidden="true"
        ></span>
      </button>
      <a
        href={withBase('/events')}
        class="rounded-full bg-terracotta-500 px-5 py-2 text-sm font-medium text-white transition hover:bg-terracotta-700"
      >
        Ver Retiros
      </a>
    </div>

    <details id="mobile-menu" class="relative md:hidden">
      <summary class="flex h-11 w-11 list-none items-center justify-center rounded-md text-ink-800 [&::-webkit-details-marker]:hidden">
        <span class="pi pi-bars text-xl" aria-hidden="true"></span>
        <span class="sr-only">Abrir menú</span>
      </summary>
      <nav
        aria-label="Menú"
        class="absolute right-0 mt-2 flex w-48 flex-col gap-1 rounded-lg border border-ink-200 bg-ink-50 p-3 shadow-lg"
      >
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="rounded px-3 py-2 text-sm text-ink-700 hover:bg-ink-100"
          >
            {link.label}
          </a>
        ))}
        <button
          id="theme-toggle-mobile"
          type="button"
          aria-pressed="false"
          data-umami-event="cambio_tema"
          data-umami-event-tema="oscuro"
          class="flex items-center gap-2 rounded px-3 py-2 text-left text-sm text-ink-700 hover:bg-ink-100"
        >
          <span
            class="pi pi-moon text-sm"
            data-theme-icon="dark"
            aria-hidden="true"
          ></span>
          <span
            class="pi pi-sun hidden text-sm"
            data-theme-icon="light"
            aria-hidden="true"
          ></span>
          <span data-theme-label>Modo oscuro</span>
        </button>
      </nav>
    </details>
  </div>

  <script is:inline>
    (function () {
      const toggles = [
        document.getElementById('theme-toggle'),
        document.getElementById('theme-toggle-mobile'),
      ].filter(Boolean);

      // Icon shows the theme a click switches TO — the same direction the
      // text label already used ("Modo oscuro" while light, prompting a
      // switch to dark). Previously the icon showed the *current* theme
      // (moon while already dark) while the label described the
      // *destination* ("Modo claro"), pointing opposite ways at a glance.
      function sync() {
        const isDark = document.documentElement.classList.contains('app-dark');
        toggles.forEach(function (toggle) {
          const sun = toggle.querySelector('[data-theme-icon="light"]');
          const moon = toggle.querySelector('[data-theme-icon="dark"]');
          const label = toggle.querySelector('[data-theme-label]');
          if (sun) sun.classList.toggle('hidden', !isDark);
          if (moon) moon.classList.toggle('hidden', isDark);
          if (label) label.textContent = isDark ? 'Modo claro' : 'Modo oscuro';
          toggle.setAttribute('aria-pressed', String(isDark));
          // Umami reads this at click time: the theme being switched to.
          toggle.setAttribute(
            'data-umami-event-tema',
            isDark ? 'claro' : 'oscuro',
          );
        });
      }

      function applyTheme() {
        const isDark = document.documentElement.classList.toggle('app-dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        sync();
      }

      // Animated switch through the View Transitions API: the browser
      // snapshots the page before and after and fades between them, so every
      // element changes together instead of each at its own speed.
      // Browsers without the API, and people who ask for reduced motion,
      // keep the instant switch.
      function toggleTheme() {
        const root = document.documentElement;
        const reduceMotion = window.matchMedia(
          '(prefers-reduced-motion: reduce)',
        ).matches;
        if (!document.startViewTransition || reduceMotion) {
          applyTheme();
          return;
        }
        root.dataset.themeTransition = '';
        document.startViewTransition(applyTheme).finished.finally(function () {
          delete root.dataset.themeTransition;
        });
      }

      toggles.forEach(function (toggle) {
        toggle.addEventListener('click', toggleTheme);
      });
      sync();
    })();

    // Theme in use, reported once per browser session. On load, Umami's
    // deferred script has run; without it (analytics off or blocked) skip.
    window.addEventListener('load', function () {
      if (!window.umami) return;
      let chosen;
      try {
        if (sessionStorage.getItem('intimar-theme-tracked')) return;
        sessionStorage.setItem('intimar-theme-tracked', '1');
        chosen = localStorage.getItem('theme') !== null;
      } catch {
        return;
      }
      window.umami.track('tema', {
        tema: document.documentElement.classList.contains('app-dark')
          ? 'oscuro'
          : 'claro',
        origen: chosen ? 'elegido' : 'sistema',
      });
    });

    // Mobile menu (the <details>/<summary> disclosure above): closing only
    // on a second tap of the hamburger left it stuck open if a visitor
    // pressed Escape or tapped elsewhere on the page — both are standard
    // expectations for a floating menu like this one.
    (function () {
      const menu = document.getElementById('mobile-menu');
      if (!(menu instanceof HTMLDetailsElement)) return;

      document.addEventListener('click', function (event) {
        if (menu.open && !menu.contains(event.target)) {
          menu.open = false;
        }
      });

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && menu.open) {
          menu.open = false;
          const summary = menu.querySelector('summary');
          if (summary instanceof HTMLElement) summary.focus();
        }
      });
    })();
  </script>
</header>
