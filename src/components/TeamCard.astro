---
// Mirrors the facilitators' "¿Quiénes somos?" Instagram cards: copper
// ribbons with thin gold lines, a round portrait with a copper ring, and the
// short third-person summary. Deep maroon ground in dark mode, a light paper
// version in light mode — the palette lives in the <style> at the bottom.
//
// The three card backgrounds are panels of one artwork that loops: card 1
// flows into card 2, 2 into 3, and 3 back into 1 (the way an Instagram
// carousel continues across slides), so any run of consecutive cards —
// however the grid wraps — reads as one continuous ribbon.
//
// The three panels are laid end to end as one 900-unit-wide loop, and
// each layer's height is sampled every 100 units around it (LOOP). Tangents
// come from a periodic Catmull-Rom spline — each knot's slope is set by its
// two neighbours — so the curve bends gradually everywhere, and the knots
// on a card edge get the same height AND angle from both sides, including
// the wrap from card 3 back to card 1. preserveAspectRatio="none" keeps
// heights and slopes proportional to the card box (cards in a row share one
// height); strokes use non-scaling-stroke so the stretch doesn't thicken
// the gold lines.
//
// Ribbons stay in the top band (behind the portrait) and along the bottom
// edge (left of the "y esta es mi historia…" link), so the centered text
// always sits on flat maroon. The feTurbulence grain is the leathery
// texture of the original artwork — the raw side of the brand's
// composed/raw tension, kept faint.
import { Image } from 'astro:assets';
import type { TeamEntry } from '../lib/data';
import { withBase } from '../lib/site';

interface Props {
  member: TeamEntry;
  index: number;
}

const { member, index } = Astro.props;
const { name, role, summary, photo } = member.data;
// SVG ids are document-global and this card renders several times per page.
const uid = `team-card-${member.id}`;

const STEP = 100;
const CARD_WIDTH = 300;
const KNOTS_PER_CARD = CARD_WIDTH / STEP;

// Offsets from each layer's base height, one per 100 units around the
// loop (card 1 = first three, card 2 = next three, card 3 = last three;
// wraps to the start). Few knots on purpose: more knots made the ribbons
// wiggle instead of sweep. Bottom values at each card's x = 0 and x = 200
// stay ≥ -4, since the "y esta es mi historia…" link sits between them.
const LOOP = {
  // prettier-ignore
  top: [
    -25, -35, 5,
    25, 20, -25,
    -20, 15, 15,
  ],
  // prettier-ignore
  bottom: [
    2, -30, 4,
    0, -22, 6,
    4, -32, 2,
  ],
};

type Knot = { x: number; offset: number; slope: number };

// This card's slice of the loop: 4 knots (both edges included), with
// Catmull-Rom slopes taken from the neighbours around the whole loop.
function cardKnots(loop: number[], card: number): Knot[] {
  const n = loop.length;
  return Array.from({ length: KNOTS_PER_CARD + 1 }, (_, j) => {
    const i = card * KNOTS_PER_CARD + j;
    const next = loop[(i + 1) % n];
    const prev = loop[(i - 1 + n) % n];
    return {
      x: j * STEP,
      offset: loop[i % n],
      slope: (next - prev) / (2 * STEP),
    };
  });
}

const card = index % (LOOP.top.length / KNOTS_PER_CARD);
const top = cardKnots(LOOP.top, card);
const bottom = cardKnots(LOOP.bottom, card);

function points(y: number, knots: Knot[], k: number) {
  return knots.map(({ x, offset, slope }) => ({
    x,
    y: y + offset * k,
    slope: slope * k,
  }));
}

// Cubic Hermite → Bézier: control points a third of the way to the next
// knot, along each knot's tangent.
function curve(pts: ReturnType<typeof points>) {
  return pts.slice(1).reduce((d, p, i) => {
    const prev = pts[i];
    const h = (p.x - prev.x) / 3;
    return `${d} C${prev.x + h},${prev.y + h * prev.slope} ${p.x - h},${p.y - h * p.slope} ${p.x},${p.y}`;
  }, '');
}

function wave(y: number, knots: Knot[], k = 1) {
  const pts = points(y, knots, k);
  return `M${pts[0].x},${pts[0].y}${curve(pts)}`;
}

// A ribbon: along the top edge left→right, then back along the bottom edge.
function band(
  yTop: number,
  yBottom: number,
  knots: Knot[],
  kTop: number,
  kBottom: number,
) {
  const back = points(yBottom, knots, kBottom).reverse();
  return `${wave(yTop, knots, kTop)} L${back[0].x},${back[0].y}${curve(back)} Z`;
}

// Layers stack top→bottom: gold line, main ribbon, thin ribbon, gold line.
// Each follows the same knots scaled by its own k, and since every layer
// shares the same x control points, the gap between two layers is their
// base spacing plus (k difference × knot offset) everywhere along the
// curve. Keeping neighbouring k's within ~0.2 means no gap can close at
// the ±35 offsets in LOOP, so ribbons never cross each other.
const shapes = {
  mainBand: band(50, 92, top, 1.2, 1),
  thinBand: band(100, 112, top, 1, 1.05),
  bottomBand: `${wave(398, bottom)} L300,420 L0,420 Z`,
  lines: [wave(40, top, 1.25), wave(122, top, 1.1), wave(390, bottom, 1.1)],
};
---

<a
  href={withBase(`/team#${member.id}`)}
  class="team-card group relative isolate flex h-full flex-col items-center overflow-hidden rounded-2xl border border-(--tc-border) bg-(--tc-bg) px-7 pt-9 pb-6 text-center text-(--tc-fg) shadow-sm transition hover:-translate-y-1 hover:shadow-lg"
>
  <svg
    aria-hidden="true"
    viewBox="0 0 300 400"
    preserveAspectRatio="none"
    class="pointer-events-none absolute inset-0 -z-10 h-full w-full"
  >
    <defs>
      <linearGradient
        id={`${uid}-copper`}
        gradientUnits="userSpaceOnUse"
        x1="0"
        y1="0"
        x2="0"
        y2="400"
      >
        <stop offset="0" style="stop-color: var(--tc-ribbon-edge)" />
        <stop offset="0.35" style="stop-color: var(--tc-ribbon)" />
        <stop offset="0.85" style="stop-color: var(--tc-ribbon)" />
        <stop offset="1" style="stop-color: var(--tc-ribbon-edge)" />
      </linearGradient>
      <filter id={`${uid}-grain`} x="0" y="0" width="100%" height="100%">
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.85"
          numOctaves="2"
          seed="7"
          stitchTiles="stitch"
        />
        <feColorMatrix type="saturate" values="0" />
      </filter>
    </defs>

    <path d={shapes.mainBand} fill={`url(#${uid}-copper)`} opacity="0.7" />
    <path d={shapes.thinBand} fill={`url(#${uid}-copper)`} opacity="0.45" />
    <path d={shapes.bottomBand} fill={`url(#${uid}-copper)`} opacity="0.6" />

    <g
      fill="none"
      stroke="var(--tc-line)"
      stroke-width="0.8"
      stroke-linecap="round"
      vector-effect="non-scaling-stroke"
      opacity="0.6"
    >
      {shapes.lines.map((d) => (
        <path d={d} vector-effect="non-scaling-stroke" />
      ))}
    </g>

    <rect
      width="300"
      height="400"
      filter={`url(#${uid}-grain)`}
      opacity="0.14"
      style="mix-blend-mode: soft-light"
    />
  </svg>

  <div class="rounded-full bg-linear-to-br from-gold-200 via-terracotta-400 to-terracotta-700 p-0.75 shadow-lg shadow-black/30">
    <Image
      src={photo}
      alt={name}
      loading="lazy"
      width={320}
      height={320}
      class="h-40 w-40 rounded-full object-cover ring-2 ring-(--tc-bg) transition duration-500 group-hover:scale-[1.02]"
    />
  </div>

  <h3 class="mt-5 font-sans text-2xl tracking-wide">{name}</h3>
  <p class="mt-3 text-sm leading-relaxed text-(--tc-muted)">
    {summary ?? role}
  </p>
  <span class="mt-auto self-end pt-6 text-sm text-(--tc-accent) underline decoration-transparent underline-offset-4 transition group-hover:decoration-(--tc-accent)">
    y esta es mi historia…
  </span>
</a>

<style>
  /* Light by default (paper card, pale copper ribbons, terracotta accents),
     the original maroon-and-copper card under dark mode. Explicit colours
     rather than the ink-* ramp: that ramp flips in dark mode, but this card
     has its own fixed dark palette (the hero maroon), so both sides are
     spelled out. Contrast for text/summary/accent checked by the a11y e2e
     suite in both themes. */
  .team-card {
    --tc-bg: #fbf5ee;
    --tc-border: #e6d6c3;
    --tc-fg: #1a1310;
    --tc-muted: #4a3d33;
    --tc-accent: #a8451f;
    --tc-ribbon: #f3cdb4;
    --tc-ribbon-edge: #e9a37c;
    --tc-line: #b8842f;
  }

  :global(.app-dark) .team-card {
    --tc-bg: #3c0a0d;
    --tc-border: transparent;
    --tc-fg: #f2e9e0;
    --tc-muted: rgb(242 233 224 / 0.85);
    --tc-accent: #ecc98a;
    --tc-ribbon: #7a2a1c;
    --tc-ribbon-edge: #b05a35;
    --tc-line: #ecc98a;
  }
</style>
