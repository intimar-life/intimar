---
import { Image } from 'astro:assets';
import { CONTACT_EMAIL, CONTACT_PAGE_ENABLED, withBase } from '../lib/site';
import logoFullLight from '../data/images/site/logo-full-light.png';
import logoFullDark from '../data/images/site/logo-full.png';

const year = new Date().getFullYear();
---

<footer class="border-t border-ink-200/60 bg-ink-100/40">
  <div class="mx-auto grid max-w-6xl gap-8 px-6 py-12 md:grid-cols-3">
    <div>
      <p class="flex items-center gap-2 font-serif text-lg text-ink-900">
        <Image
          src={logoFullLight}
          alt=""
          width={489}
          height={1150}
          class="h-16 w-auto in-[.app-dark]:hidden"
        />
        <Image
          src={logoFullDark}
          alt=""
          width={489}
          height={1150}
          class="hidden h-16 w-auto in-[.app-dark]:block"
        />
        Intimar
      </p>
      <p class="mt-2 max-w-xs text-sm text-ink-700">
        Retiros de neotantra presenciales, guiados por un equipo selecto, con
        raíces en la presencia y el contacto consciente.
      </p>
    </div>

    <nav
      aria-labelledby="footer-explore-heading"
      class="flex flex-col gap-2 text-sm text-ink-700"
    >
      <p id="footer-explore-heading" class="text-sm font-semibold text-ink-900">
        Explorar
      </p>
      <a href={withBase('/events')} class="hover:text-ink-900">
        Próximos retiros
      </a>
      <a href={withBase('/team')} class="hover:text-ink-900">
        Nuestros facilitadores
      </a>
      <a href={withBase('/about')} class="hover:text-ink-900">
        Sobre Intimar
      </a>
      <a href={withBase('/faq')} class="hover:text-ink-900">
        Preguntas frecuentes
      </a>
    </nav>

    <address class="flex flex-col gap-2 text-sm text-ink-700 not-italic">
      <p class="text-sm font-semibold text-ink-900">Contáctanos</p>
      {CONTACT_PAGE_ENABLED && (
        <a href={withBase('/contact')} class="hover:text-ink-900">
          Escríbenos
        </a>
      )}
      <a href={`mailto:${CONTACT_EMAIL}`} class="hover:text-ink-900">
        {CONTACT_EMAIL}
      </a>
    </address>
  </div>

  <p class="border-t border-ink-200/60 px-6 py-4 text-center text-xs text-ink-600">
    © {year} Intimar. Todos los derechos reservados. ·{' '}
    <a
      href={withBase('/privacy')}
      class="underline-offset-2 hover:text-ink-900 hover:underline"
    >
      Política de privacidad
    </a>
  </p>
</footer>
